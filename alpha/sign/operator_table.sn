		gpr_frame : `add`
		gpr_static_page : `adrp`
		gpr_static_off : `add`

`--- prefix の命令（width） ---`

#asm_prefix_width :
	`@` :
		form : `mem`
		gpr_w1 : `ldrb`
		gpr_w2 : `ldrh`
		gpr_w4 : `ldr`
		gpr_w8 : `ldr`

`--- postfix の命令（shape） ---`

