ix : k m ? (k < m) & (k (ix (k + 1) m)~)

safe : c d p [x ~t] ?
	|c - x| > d | |c - x| < d :
		d = p : c
		safe c d + 1 p t

place : n m k [~qs] [c ~r] ?
	m = n | safe c 1 n - m qs : (m < 2 & (c qs~)) | (place n (m - 1) (m - 1) (c qs~) r)
	k > 1 : place n m (k - 1) qs (r~ c)

nqueens : n ? place n n n (ix 0 0) (ix 0 n)